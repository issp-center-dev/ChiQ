[chiq_common]
input = "dmft_bse.h5"
output = "dmft_bse.out.h5"
type = ["chi0", "bse"]
q_points = "q_path.dat"
num_wb = -1  # -1 means all frequencies (default)

[chiq_main]
work_dir = "work/chiq"
# num_wf = 20  # If not specified, the value is determined from X_loc

[chiq_post]
output_dir = "bse"
mode = ["linear_combination"]
coefs_file = "coefs.in"

[chiq_anacont]
input_file = "chi_q_linear_combination.dat"
wmax = 20.0
wnum = 201
